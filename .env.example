# Copy this file to `.env` and adjust values for your local environment.

# Local web server settings
TEQ_CMS__BASE_URL=http://127.0.0.1:3000
TEQFW_WEB__PORT=3000
TEQFW_WEB__TYPE=http

# Locale settings
TEQFW_TMPL__ALLOWED_LOCALES=en,es,ru
TEQ_CMS__LOCALE_BASE_TRANSLATE=ru
TEQFW_TMPL__DEFAULT_LOCALE=en

# Optional template engine override
# TEQFW_TMPL__ENGINE=nunjucks

# Optional AI translation settings
# TEQ_CMS__AI_API_BASE_URL=
# TEQ_CMS__AI_API_KEY=
# TEQ_CMS__AI_API_MODEL=
# TEQ_CMS__AI_API_ORG=

# Email settings for the contact form handler
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_TO=Alex Gusev <alex@wiredgeese.com>
# EMAIL_AUTH_USER=your-email@gmail.com
# EMAIL_AUTH_PASS=your-app-password
