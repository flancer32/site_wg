{
  "name": "@flancer32/site_wg",
  "version": "0.2.0",
  "description": "Sources for Alex Gusev’s personal website wiredgeese.com powered by TeqCMS — a minimal multilingual CMS with SSR and AI localization.",
  "type": "module",
  "types": "./types.d.ts",
  "keywords": [
    "teqcms",
    "teqfw",
    "ssr",
    "multilingual",
    "static site",
    "localization",
    "cms",
    "nodejs",
    "openai"
  ],
  "homepage": "https://github.com/flancer32/site_wg#readme",
  "bugs": {
    "url": "https://github.com/flancer32/site_wg/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flancer32/site_wg.git"
  },
  "scripts": {
    "start": "teq fl32:web:start",
    "test": "node --test test/unit/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "sitemap": "node bin/generate-sitemap.mjs",
    "translate": "teq cms:translate"
  },
  "dependencies": {
    "@flancer32/teq-cms": "<=1.0.0",
    "@teqfw/cli": "^2.1.0",
    "nodemailer": "^9.0.3",
    "nunjucks": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "whatwg-url": "13.0.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/teqfw"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "App_",
            "path": "./src",
            "ext": ".js"
          }
        ]
      },
      "cli": {
        "command": {
          "default": "fl32:web:start"
        },
        "container": {
          "configurator": "./teqcms.config.mjs"
        },
        "plugin": "App_Back_Cli_Plugin$"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
